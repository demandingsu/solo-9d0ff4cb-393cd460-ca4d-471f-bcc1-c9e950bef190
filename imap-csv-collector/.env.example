MAIL_USER=instrument@lab.local
MAIL_PASSWORD=labpass
MAIL_ROOT=/srv/mail
COLLECTOR_DB=/data/collector.db
# 设为正整数 N 时，每条 IMAP 连接第 N 次 FETCH 发送一半响应即断线，用于演示
FLAKY_FETCH_AFTER=0
# 统一规则重算（演示用；生产可删除，默认每批 500 条、无暂停、不注入失败）
RULE_RECOMPUTE_CHUNK_SIZE=1
RULE_RECOMPUTE_PAUSE_SECONDS=1
RULE_RECOMPUTE_FAIL_AFTER=0
# imap 启动时追加“项目名/单位不统一”的演示邮件
MAIL_SEED_UNIFIED=1
